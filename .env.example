# Required: server-side only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=
# Optional: model override. Defaults to claude-sonnet-4-20250514 if unset.
ANTHROPIC_MODEL=
# Optional: increases GitHub API rate limit (60 req/hr anonymous -> 5000 req/hr with token).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=
